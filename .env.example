# Desarrollo local. Para actualizar, conserva tu .env existente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=virelia_app
DB_PASSWORD=
DB_PREFIX=virelia
DB_TLS=false
DB_CA_FILE=
INTERNAL_API_KEY=
HOST=127.0.0.1
GATEWAY_PORT=3000
AFILIADOS_PORT=3001
CITAS_PORT=3002
DOCUMENTOS_PORT=3003
NOTIFICACIONES_PORT=3004
PUBLIC_APP_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_LOGIN_OTP=true
SEED_DEMO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Solo preparación y migración. No enviar al runtime de producción.
MYSQL_ROOT_PASSWORD=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Opcional local; obligatorios en producción.
AFILIADOS_DB_USER=
AFILIADOS_DB_PASSWORD=
CITAS_DB_USER=
CITAS_DB_PASSWORD=
DOCUMENTOS_DB_USER=
DOCUMENTOS_DB_PASSWORD=
NOTIFICACIONES_DB_USER=
NOTIFICACIONES_DB_PASSWORD=
